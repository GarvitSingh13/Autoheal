[Unit]
Description=AutoHeal lab network simulator (NETCONF/RESTCONF/PDU) - lab use only
After=network-online.target

[Service]
Type=simple
User=autoheal
Group=autoheal
WorkingDirectory=/opt/autoheal
EnvironmentFile=-/etc/autoheal/autoheal.env
ExecStart=/opt/autoheal/venv/bin/autoheal sim --topology /etc/autoheal/topology.yaml --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
